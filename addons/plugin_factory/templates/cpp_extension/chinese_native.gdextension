[configuration]
entry_symbol = "chinese_native_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
android.arm64 = "res://bin/native/libchinese_native.so"
linux.debug.x86_64 = "res://bin/native/libchinese_native.so"
linux.release.x86_64 = "res://bin/native/libchinese_native.so"
